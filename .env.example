# Luma form — Google Sheets + Drive (students + partners)
#
# 1. Student sheet — import scripts/sheet-templates/student-applications.csv
# 2. Business sheet — import scripts/sheet-templates/business-partners.csv
# 3. MTC emails sheet — import scripts/sheet-templates/mtc-emails.csv
# 4. Drive folder for resumes — set RESUME_FOLDER_ID in Apps Script
# 5. Deploy scripts/google-apps-script-luma-form.js as Web app → Anyone
GOOGLE_FORM_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
